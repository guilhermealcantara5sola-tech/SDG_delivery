# ==============================================================================
# CONFIGURAÇÃO DO SUPABASE - SDG DELIVERY
# ==============================================================================
# 1. Crie um projeto gratuito em: https://supabase.com
# 2. No menu do projeto, acesse: Project Settings -> API
# 3. Copie o "Project URL" e a chave pública "Project API Keys -> anon / public"
# 4. Crie um arquivo chamado .env.local nesta mesma pasta e cole seus valores abaixo:
#
# Dica: Você também pode configurar diretamente na tela de "Links de Acesso / Admin"
# do sistema pelo próprio navegador!

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
